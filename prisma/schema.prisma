generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model User {
  id        String     @id @default(cuid())
  name      String
  email     String     @unique
  password  String
  role      Role       @default(SCOOTEIRA)
  createdAt DateTime   @default(now())
  consultas Consulta[]
}

enum Role {
  ADMIN
  SCOOTEIRA
}

model Consulta {
  id            String    @id @default(cuid())
  cnpj          String
  representante String?
  resultado     Resultado
  dadosJson     Json
  criadoEm      DateTime  @default(now())
  usuarioId     String
  usuario       User      @relation(fields: [usuarioId], references: [id])

  @@index([cnpj])
  @@index([criadoEm])
  @@index([resultado])
}

enum Resultado {
  OK
  ATENCAO
  IRREGULAR
}

model PgfnDevedor {
  id                Int      @id @default(autoincrement())
  cpfCnpj           String
  nomeDevedor       String
  ufDevedor         String?
  tipoDevedor       String?
  situacaoInscricao String?
  tipoSituacao      String?
  valorConsolidado  String?
  dataInscricao     String?
  indicadorAjuizado String?
  tipoDivida        String   // NaoPrevidenciario | Previdenciario | FGTS

  @@index([cpfCnpj])
}
