generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model User {
  id        String     @id @default(cuid())
  name      String
  email     String     @unique
  password  String
  role      Role       @default(SCOOTEIRA)
  createdAt DateTime   @default(now())
  consultas Consulta[]
  demandas  Demanda[]
}

enum Role {
  ADMIN
  SCOOTEIRA
}

model Consulta {
  id            String    @id @default(cuid())
  cnpj          String
  representante String?
  resultado     Resultado
  dadosJson     Json
  criadoEm      DateTime  @default(now())
  usuarioId     String
  usuario       User      @relation(fields: [usuarioId], references: [id])

  @@index([cnpj])
  @@index([criadoEm])
  @@index([resultado])
}

enum Resultado {
  OK
  ATENCAO
  IRREGULAR
}

model Demanda {
  id           String        @id @default(cuid())
  titulo       String
  descricao    String
  tipo         TipoDemanda
  prioridade   Prioridade    @default(NORMAL)
  status       StatusDemanda @default(PENDENTE)
  solicitante  String        // nome livre (sem login)
  setor        String?
  operacao     String?
  cliente      String?
  anexos       String[]      // URLs dos arquivos enviados
  responsavelId String?
  responsavel  User?         @relation(fields: [responsavelId], references: [id])
  prazo        DateTime?
  notas        String?
  criadoEm     DateTime      @default(now())
  atualizadoEm DateTime      @updatedAt

  @@index([status])
  @@index([responsavelId])
  @@index([criadoEm])
}

enum TipoDemanda {
  CONTRATO
  PROCESSO
  CONSULTA_JURIDICA
  DOCUMENTO
  OUTRO
}

enum Prioridade {
  BAIXA
  NORMAL
  ALTA
  URGENTE
}

enum StatusDemanda {
  PENDENTE
  EM_ANDAMENTO
  AGUARDANDO
  CONCLUIDO
  CANCELADO
}

model PgfnDevedor {
  id                Int      @id @default(autoincrement())
  cpfCnpj           String
  nomeDevedor       String
  ufDevedor         String?
  tipoDevedor       String?
  situacaoInscricao String?
  tipoSituacao      String?
  valorConsolidado  String?
  dataInscricao     String?
  indicadorAjuizado String?
  tipoDivida        String   // NaoPrevidenciario | Previdenciario | FGTS

  @@index([cpfCnpj])
}
