generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model User {
  id           String        @id @default(cuid())
  name         String
  email        String        @unique
  password     String
  role         Role          @default(SCOOTEIRA)
  createdAt    DateTime      @default(now())
  consultas    Consulta[]
  demandas     Demanda[]
  comentarios  Comentario[]  @relation("AutorComentarios")
  notificacoes Notificacao[] @relation("NotificacoesRecebidas")
  templates    Template[]
}

enum Role {
  ADMIN
  SCOOTEIRA
}

model Consulta {
  id            String    @id @default(cuid())
  cnpj          String
  representante String?
  resultado     Resultado
  dadosJson     Json
  criadoEm      DateTime  @default(now())
  usuarioId     String
  usuario       User      @relation(fields: [usuarioId], references: [id])

  @@index([cnpj])
  @@index([criadoEm])
  @@index([resultado])
}

enum Resultado {
  OK
  ATENCAO
  IRREGULAR
}

model Demanda {
  id               String     @id @default(cuid())
  titulo           String
  descricao        String
  tipo             TipoDemanda
  prioridade       Prioridade @default(NORMAL)
  status           String     @default("PENDENTE")
  solicitante      String
  emailSolicitante String?
  setor            String?
  operacao         String?
  cliente          String?
  anexos           String[]
  responsavelId    String?
  responsavel      User?      @relation(fields: [responsavelId], references: [id])
  prazoSolicitado  DateTime?  // prazo pedido pelo solicitante (referência)
  prazo            DateTime?  // prazo interno definido pela equipe
  notas            String?
  comentarios      Comentario[]
  criadoEm         DateTime   @default(now())
  atualizadoEm     DateTime   @updatedAt

  @@index([status])
  @@index([responsavelId])
  @@index([criadoEm])
}

model Comentario {
  id        String   @id @default(cuid())
  demandaId String
  demanda   Demanda  @relation(fields: [demandaId], references: [id], onDelete: Cascade)
  autorId   String
  autor     User     @relation("AutorComentarios", fields: [autorId], references: [id])
  texto     String
  criadoEm DateTime @default(now())

  @@index([demandaId])
}

model Notificacao {
  id        String   @id @default(cuid())
  usuarioId String
  usuario   User     @relation("NotificacoesRecebidas", fields: [usuarioId], references: [id])
  tipo      String
  titulo    String
  texto     String?
  demandaId String?
  lida      Boolean  @default(false)
  criadoEm DateTime @default(now())

  @@index([usuarioId, lida])
  @@index([criadoEm])
}

model StatusConfig {
  id       String  @id
  nome     String
  cor      String  @default("#E2E8F0")
  corTexto String  @default("#475569")
  ordem    Int     @default(0)
  ativo    Boolean @default(true)
}

model Template {
  id           String   @id @default(cuid())
  titulo       String
  categoria    String   // EMAIL | MENSAGEM | DOCUMENTO | SITUACAO
  situacao     String?
  assunto      String?
  conteudo     String
  tags         String[]
  variaveis    String[]
  cc           String[]
  autorId      String?
  autor        User?    @relation(fields: [autorId], references: [id])
  criadoEm    DateTime @default(now())
  atualizadoEm DateTime @updatedAt

  @@index([categoria])
}

enum TipoDemanda {
  CONTRATO
  PROCESSO
  CONSULTA_JURIDICA
  DOCUMENTO
  OUTRO
}

enum Prioridade {
  BAIXA
  NORMAL
  ALTA
  URGENTE
}

model PgfnDevedor {
  id                Int      @id @default(autoincrement())
  cpfCnpj           String
  nomeDevedor       String
  ufDevedor         String?
  tipoDevedor       String?
  situacaoInscricao String?
  tipoSituacao      String?
  valorConsolidado  String?
  dataInscricao     String?
  indicadorAjuizado String?
  tipoDivida        String   // NaoPrevidenciario | Previdenciario | FGTS

  @@index([cpfCnpj])
}
